# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/dipx2368/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/dipx2368/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# ---------- Tekoala ----------
# File ini disalin ke build/ saat `npm run build` (lihat webpack.config.js).
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

RewriteEngine On

# Biarkan validasi SSL (AutoSSL / Let's Encrypt)
RewriteRule ^\.well-known/ - [L]

# Paksa HTTPS + tanpa www -> https://tekoala.id
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://tekoala.id/$1 [R=301,L]

# Blokir file tersembunyi (.git, .env, dll.) dan php.ini
RewriteRule (^|/)\. - [F]
RewriteRule ^php\.ini$ - [F]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]

# /pelatihan.html -> /pelatihan (query string ikut terbawa)
RewriteCond %{THE_REQUEST} \s/[^\s?]+\.html[\s?]
RewriteRule ^([a-z0-9-]+)\.html$ /$1 [R=301,L]

# /pelatihan/ -> /pelatihan (garis miring di akhir bikin path aset relatif rusak)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/$ /$1 [R=301,L]

# /pelatihan -> pelatihan.html (internal, URL di browser tetap bersih)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z0-9-]+)$ $1.html [L]

# Kompresi
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache browser (CSS/JS tidak di-hash, jadi jangan terlalu lama)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
