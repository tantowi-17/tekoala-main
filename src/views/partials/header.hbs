<!-- Header
============================================= -->
<header>
    <!-- Start Navigation -->
    <nav class="navbar mobile-sidenav navbar-sticky navbar-default validnavs nav-full-width navbar-fixed">
        <div class="container-full d-flex justify-content-between align-items-center">

            <!-- Start Header Navigation -->
            <div class="col-xl-2 col-lg-3">
                <div class="navbar-header">
                    <a class="navbar-brand" href="/">
                        <img src="{{this.logoLight}}" class="logo" alt="{{brand.name}}">
                        <img src="{{this.logoDark}}" class="logo-dark" alt="{{brand.name}}">
                    </a>
                </div>
            </div>
            <!-- End Header Navigation -->

            <!-- Collect the nav links, forms, and other content for toggling -->
            <div class="col-xl-7 col-lg-6">
                <div class="collapse navbar-collapse" id="navbar-menu">
                    <div class="left-info">
                        <p><strong>Konsultasi</strong> <a href="https://wa.me/{{this.phone}}?text={{urlencode this.waText}}" target="_blank" rel="noopener"
                            data-track="contact_whatsapp" data-track-location="header">{{this.phoneDisplay}}</a></p>
                    </div>
                    <div class="right-info">
                        <ul>
                            <li><a href="{{this.instagram}}" target="_blank" rel="noopener" aria-label="Instagram"><i class="fab fa-instagram"></i></a></li>
                            <li><a href="https://wa.me/{{this.phone}}" target="_blank" rel="noopener" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a></li>
                            <li><a href="mailto:{{this.email}}" aria-label="Email"><i class="far fa-envelope"></i></a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="attr-right">
                <!-- Start Atribute Navigation -->
                <div class="attr-nav flex">
                    <ul>
                        <li class="side-menu">
                            <a href="#">
                                <strong>MENU </strong>
                                <div class="line">
                                    <span class="bar-1"></span>
                                    <span class="bar-2"></span>
                                    <span class="bar-3"></span>
                                </div>
                            </a>
                        </li>
                    </ul>
                </div>
                <!-- End Atribute Navigation -->


                <div class="col-lg-2">
                    <!-- Start Side Menu -->
                    <div class="side">
                        <a href="#" class="close-side">Tutup <i class="fas fa-times"></i></a>
                        <div class="widget">
                            <div class="logo">
                                <a href="/"><img src="{{this.logoLight}}" alt="{{brand.name}}"></a>
                            </div>
                        </div>
                        <div class="container">
                            <div class="row">
                                <div class="col-xl-7 col-lg-7">
                                    <div class="side-navbar-inner">
                                        <div class="simple-menu">
                                            <ul class="simple-menu-list">
                                                {{#each nav}}
                                                <li{{#if (eq this.key @root.pageKey)}} class="active"{{/if}}><a href="{{this.url}}">{{this.label}}</a></li>
                                                {{/each}}
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-4 offset-xl-1 col-lg-4 offset-lg-1">
                                    <div class="side-widgets">
                                        <div class="widget address">
                                            <div>
                                                <ul>
                                                    <li>
                                                        <div class="content">
                                                            <p>Lokasi</p>
                                                            <strong>Makassar &amp; Mamuju Tengah</strong>
                                                        </div>
                                                    </li>
                                                    <li>
                                                        <div class="content">
                                                            <p>Email</p>
                                                            <strong>{{this.email}}</strong>
                                                        </div>
                                                    </li>
                                                    <li>
                                                        <div class="content">
                                                            <p>WhatsApp</p>
                                                            <strong><a href="https://wa.me/{{this.phone}}" target="_blank" rel="noopener">{{this.phoneDisplay}}</a></strong>
                                                        </div>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                        <div class="widget social">
                                            <ul class="link">
                                                <li><a href="{{this.instagram}}" target="_blank" rel="noopener" aria-label="Instagram"><i class="fab fa-instagram"></i></a></li>
                                                <li><a href="https://wa.me/{{this.phone}}" target="_blank" rel="noopener" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a></li>
                                                <li><a href="mailto:{{this.email}}" aria-label="Email"><i class="far fa-envelope"></i></a></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <!-- End Side Menu -->

                </div>
            </div>
            <!-- Main Nav -->

        </div>
        <!-- Overlay screen for menu -->
        <div class="overlay-screen"></div>
        <!-- End Overlay screen for menu -->
    </nav>
    <!-- End Navigation -->
</header>
<!-- End Header -->