<!-- Start Fun Factor
============================================= -->
<div class="fun-factor-circle-area {{#if this.padding}}{{this.padding}}{{else}}default-padding{{/if}}{{#if this.bg}} {{this.bg}}{{/if}}">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="fun-fact-circle-lists">
                    {{#each this.items}}
                    <!-- Single item -->
                    <div class="fun-fact wow {{#if @odd}}fadeInUp{{else}}fadeInDown{{/if}}"{{#if @odd}} data-wow-duration="0.5s"{{/if}}>
                        <div class="counter">
                            <div class="timer">{{this.value}}</div>
                            <div class="operator">{{this.operator}}</div>
                        </div>
                        <span class="medium">{{this.label}}</span>
                    </div>
                    <!-- End Single item -->
                    {{/each}}
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End Fun Factor -->
