<!-- Start Portfolio
============================================= -->
<div class="portfolio-style-three-area default-padding{{#if this.bg}} {{this.bg}}{{/if}}"{{#if this.id}} id="{{this.id}}"{{/if}}>
    <div class="container">
        <div class="row">
            <div class="col-lg-7 offset-lg-3">
                <div class="site-heading text-center">
                    <h4 class="sub-title">{{this.subTitle}}</h4>
                    <h2 class="title split-text">{{this.title}}</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="portfolio-style-three-items">
            {{#each this.items}}
            <!-- Single Item -->
            <div class="portfolio-style-three-item">
                <div class="row align-center">
                    <div class="col-lg-7">
                        <img src="{{this.image}}" alt="{{this.title}} {{this.titleBold}}">
                    </div>
                    <div class="col-lg-5">
                        <div class="date">{{this.category}}</div>
                        <h2>{{#if this.url}}<a href="{{this.url}}">{{/if}}{{this.title}} <strong>{{this.titleBold}}</strong>{{#if this.url}}</a>{{/if}}</h2>
                        {{#if this.url}}
                        <a class="btn-animation mt-10" href="{{this.url}}"><i class="fas fa-arrow-right"></i> <span>Lihat Detail</span></a>
                        {{/if}}
                    </div>
                </div>
            </div>
            <!-- Single Item -->
            {{/each}}
        </div>
    </div>
</div>
<!-- End Portfolio -->
