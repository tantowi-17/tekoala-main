<!-- Start Testimonial
 ============================================= -->
{{#with (filled (ofType @root.testimonials.items this.types)) as |reviews|}}
{{#if reviews.length}}
<div class="testimonial-style-three-area default-padding{{#if ../bg}} {{../bg}}{{/if}}">
    <div class="shape-style-one">
        <img class="upDownScrol" src="../../assets/img/shape/14.png" alt="">
    </div>
    <div class="container">
        <div class="testimonial-heading">
            <div class="row">
                <div class="col-lg-8">
                    <h2 class="text-large-gradient">
                        {{../title}}
                    </h2>
                </div>
                {{#if (avgRating reviews)}}
                <div class="col-lg-4 text-end">
                    <div class="testimonial-three-quote">
                        <h2>{{avgRating reviews}}</h2>
                        <div class="info">
                            <div class="ratings">
                                {{{stars (avgRating reviews)}}}
                            </div>
                            <span>Rata-rata dari {{approvedCount reviews}} ulasan</span>
                        </div>
                    </div>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-lg-12">

                <div class="testimonial-style-three-carousel swiper">
                    <div class="swiper-wrapper">
                        {{#each reviews}}
                        <!-- Single Item -->
                        <div class="swiper-slide">
                            <div class="testimonial-style-three-item">
                                <div class="tes-rating">
                                    {{#if this.rating}}<span>{{this.rating}}</span>{{/if}}
                                    <div class="icon">
                                        {{{stars this.rating}}}
                                    </div>
                                    {{#if this.category}}<span class="tes-category">{{this.category}}</span>{{/if}}
                                </div>
                                <p>
                                    {{this.text}}
                                </p>
                                <div class="tm-provider">
                                    <div class="thumb">
                                        {{#if this.avatar}}
                                        <img src="{{this.avatar}}" alt="{{this.name}}">
                                        {{else}}
                                        <span class="tes-initials" aria-hidden="true">{{#if this.name}}{{initials this.name}}{{else}}{{initials this.role}}{{/if}}</span>
                                        {{/if}}
                                    </div>
                                    <div class="content">
                                        <h4>{{#if this.name}}{{this.name}}{{else}}[Nama]{{/if}}</h4>
                                        <span>{{this.role}}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- End Single Item -->
                        {{/each}}
                    </div>

                    <!-- Navigation -->
                    <div class="testimonial-control">
                        <div class="swiper-pagination"></div>
                        <div class="swiper-nav-left">
                            <div class="swiper-button-prev"></div>
                            <div class="swiper-button-next"></div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
{{/if}}
{{/with}}
<!-- End Testimonial -->
