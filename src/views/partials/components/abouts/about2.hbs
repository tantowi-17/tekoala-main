<!-- Start About
============================================= -->
<div class="about-style-six-area default-padding{{#if this.bg}} {{this.bg}}{{/if}}"{{#if this.id}} id="{{this.id}}"{{/if}}>
    <div class="container">
        <div class="row">
            <div class="col-xl-5 col-lg-5">
                <div class="thumb-style-four">
                    <img src="{{this.image}}" alt="{{this.title}}">
                </div>
            </div>
            <div class="col-xl-6 offset-xl-1 col-lg-7">
                <div class="about-style-six-info text-scroll-animation">
                    <div class="info">
                        <div class="d-flex">
                            <a href="{{this.url}}"><img src="../../assets/img/icon/arrow.png" alt=""></a>
                            <h2 class="title text">{{this.title}}</h2>
                        </div>
                        <p class="text">
                            {{this.description}}
                        </p>
                    </div>
                    <ul class="service-list">
                        {{#each this.list}}
                        <li>
                            <a href="{{../url}}">
                                <div class="icon">
                                    <i class="fas fa-long-arrow-right"></i>
                                </div>
                                <span>{{incPad @index}}</span>
                                {{this}}
                            </a>
                        </li>
                        {{/each}}
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End About -->
