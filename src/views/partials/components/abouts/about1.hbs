<!-- Start About
        ============================================= -->
<div class="about-style-three-area default-padding-bottom bg-gray"{{#if this.id}} id="{{this.id}}"{{/if}}>
    <div class="container">
        <div class="row align-center">
            <div class="col-lg-5">
                <div class="thumb-style-three">
                    <img src="{{#if this.image}}{{this.image}}{{else}}../../assets/img/about/about01.jpg{{/if}}" alt="{{this.label}}">
                    <div class="upDownScrol scroll-shape"></div>
                </div>
            </div>
            <div class="col-lg-6 offset-lg-1">
                <div class="about-style-three-info text-scroll-animation">
                    <h2 class="title text">{{this.title}}</h2>
                    <div class="d-flex mt-40">
                        <div class="left">
                            <h4 class="sub-title-border"><strong>{{this.label}}</strong></h4>
                        </div>
                        <div class="right">
                            <p class="text">
                                {{this.description}}
                            </p>
                            {{#if this.button}}
                            <a class="btn-animation mt-10" href="{{this.button.url}}"><i class="fas fa-arrow-right"></i> <span>{{this.button.label}}</span></a>
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End About -->
