<!-- Start Banner
============================================= -->
<div class="banner-style-eight-area bg-cover" style="background-image: url({{this.bgShape1}});">
    <div class="light-banner-active bg-gray bg-cover" style="background-image: url({{this.bgShape2}});"></div>
    <div class="container">
        <div class="row">
            <div class="col-xl-8">
                <div class="banner-style-eight-heading">
                    {{#if this.h1}}<h1 class="visually-hidden">{{this.h1}}</h1>{{/if}}
                    <div class="banner-title" aria-hidden="true">
                        <h2 class="title-left split-text">{{this.heading.left}}</h2>
                        <h2 class="title-right split-text">{{this.heading.right}}</h2>
                    </div>
                </div>
            </div>
            <div class="col-xl-4">
                <div class="thumb">
                    <img src="{{this.illustration}}" alt="{{this.heading.left}} {{this.heading.right}}">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-xl-7">
                <div class="d-grid">
                    <h4>{{this.label}}</h4>
                    <div class="right">
                        {{{this.description}}}
                        <div class="banner-actions">
                            {{#each this.buttons}}
                            <a class="btn-animation mt-10" href="{{this.url}}"{{#if this.event}} onclick="gtag('event', '{{this.event}}', { 'location': 'banner' });"{{/if}}><i class="fas fa-arrow-right"></i> <span>{{this.label}}</span></a>
                            {{/each}}
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-4 offset-xl-1">
                <div class="card-style-one">
                    <div class="bottom">
                        <div class="fun-fact">
                            <div class="counter">
                                <div class="timer">{{this.stat.value}}</div>
                                <div class="operator">{{this.stat.operator}}</div>
                            </div>
                            <span class="medium">{{this.stat.label}}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End Banner -->