<!-- Start Services Hover
============================================= -->
<div class="services-style-two-area{{#if this.title}} default-padding-top{{/if}}{{#if this.bg}} {{this.bg}}{{/if}} overflow-hidden"{{#if this.id}} id="{{this.id}}"{{/if}}>
    {{#if this.title}}
    <div class="container">
        <div class="row">
            <div class="col-xl-6 offset-xl-3 col-lg-8 offset-lg-2">
                <div class="site-heading text-center">
                    <h4 class="sub-title">{{this.subTitle}}</h4>
                    <h2 class="title split-text">{{this.title}}</h2>
                </div>
            </div>
        </div>
    </div>
    {{/if}}
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="service-hover-items">
                    <ul>
                        {{#each this.items}}
                        <li class="hover-active-item{{#if @first}} active{{/if}}">
                            <a href="{{this.url}}" class="service-hover-item">
                                <div class="service-hover-content">
                                    <div class="left">
                                        <div class="icon">
                                            <img src="{{this.icon}}" alt="{{this.title}}">
                                        </div>
                                        <div class="item-title">
                                            <span>{{this.label}}</span>
                                            <h2>{{this.title}}</h2>
                                        </div>
                                    </div>
                                    <div class="details">
                                        <p>{{this.description}}</p>
                                        <ul class="list-style-five">
                                            {{#each this.list}}
                                            <li>{{this}}</li>
                                            {{/each}}
                                        </ul>
                                    </div>
                                    <div class="arrow">
                                        <strong class="btn-arrow-xl"><i class="fas fa-long-arrow-right"></i></strong>
                                    </div>
                                </div>
                                <div class="service-hover-wrapper">
                                    <img class="service-hover-placeholder" src="{{this.image}}" alt="{{this.title}}">
                                </div>
                            </a>
                        </li>
                        {{/each}}
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End Services Hover -->
