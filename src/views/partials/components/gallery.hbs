<!-- Start Accordion Gallery
============================================= -->
<div class="accrdion-portfolio-area">
    <div class="container-fluid">
        <div class="row">
            <ul class="accordion-portfolio-lists text-light" id="accordion">
                {{#each this.items}}
                <li{{#if this.out}} class="out"{{/if}} style="background-image: url('{{this.image}}');">
                    <h3>{{this.title}} {{this.titleBold}}</h3>
                    <div class="accordion-overlay">
                        <h2>{{this.title}} <strong>{{this.titleBold}}</strong></h2>
                        <span>{{this.category}}</span>
                    </div>
                </li>
                {{/each}}
            </ul>
        </div>
    </div>
</div>
<!-- End Accordion Gallery -->
