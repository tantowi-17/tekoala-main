<!-- Start Footer
============================================= -->
<footer>
    <div class="container">
        <div class="f-items">
            <div class="row">
                <!-- Singel Item -->
                <div class="col-lg-5 footer-item about pr-60 pr-md-15 pr-xs-15">
                    <div class="top">
                        <img class="regular-img" src="{{logoLight}}" alt="{{brand.name}}">
                        <img class="light-img" src="{{logoDark}}" alt="{{brand.name}}">
                    </div>
                    <p class="mt-25">{{footer.about}}</p>
                    <ul class="address-list">
                        {{#each footer.address}}
                        <li>{{{this.label}}}</li>
                        {{/each}}
                    </ul>
                </div>
                <!-- End Singel Item -->
                <!-- Singel Item -->
                <div class="col-lg-3 offset-lg-1 col-md-6 footer-item">
                    <h4 class="widget-title">Program</h4>
                    <ul class="useful-link list-single">
                        {{#each footer.programs}}
                        <li><a href="{{this.url}}">{{this.label}}</a></li>
                        {{/each}}
                    </ul>
                </div>
                <!-- End Singel Item -->
                <!-- Singel Item -->
                <div class="col-lg-3 col-md-6 footer-item">
                    <h4 class="widget-title">Layanan &amp; Info</h4>
                    <ul class="useful-link list-single">
                        {{#each footer.links}}
                        <li><a href="{{this.url}}">{{this.label}}</a></li>
                        {{/each}}
                    </ul>
                    <div class="footer-contact">
                        <ul>
                            <li>
                                <a href="mailto:{{email}}">{{email}}</a>
                            </li>
                            <li>
                                <a href="https://wa.me/{{phone}}?text={{urlencode waText}}" target="_blank" rel="noopener"
                                    data-track="contact_whatsapp" data-track-location="footer">
                                    {{phoneDisplay}}
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
                <!-- End Singel Item -->

            </div>
        </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
        <div class="container">
            <div class="row">
                <div class="col-lg-6">
                    <ul class="footer-social">
                        <li><a href="{{instagram}}" target="_blank" rel="noopener" aria-label="Instagram"
                                data-track="social_click" data-track-platform="instagram"><i
                                    class="fab fa-instagram"></i></a></li>
                        <li><a href="https://wa.me/{{phone}}" target="_blank" rel="noopener" aria-label="WhatsApp"
                                data-track="social_click" data-track-platform="whatsapp"><i
                                    class="fab fa-whatsapp"></i></a></li>
                        <li><a href="mailto:{{email}}" aria-label="Email"
                                data-track="social_click" data-track-platform="email"><i
                                    class="far fa-envelope"></i></a></li>
                    </ul>
                </div>
                <div class="col-lg-6 text-end">
                    <p>
                        Copyright &copy; 2026 {{brand.name}}. All Rights Reserved
                    </p>
                </div>
            </div>
        </div>
    </div>
    <!-- End Footer Bottom -->
</footer>
<!-- End Footer -->