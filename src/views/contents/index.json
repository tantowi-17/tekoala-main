    "faq": {
        "subTitle": "FAQ",
        "title": "Pertanyaan yang Sering Diajukan",
        "items": [
            {
                "q": "Saya benar-benar pemula, apakah bisa ikut?",
                "a": "Bisa. Bootcamp Web Development dan Digital Marketing dirancang mulai dari dasar. Yang dibutuhkan hanya laptop, koneksi internet, dan komitmen mengikuti kelas."
            },
            {
                "q": "Kelasnya online atau offline?",
                "a": "Bootcamp berjalan online lewat sesi live (Zoom/Google Meet) dan rekaman. Untuk pelatihan instansi dan desa, kami bisa datang langsung ke lokasi (in-house)."
            },
            {
                "q": "Apakah ada sertifikat?",
                "a": "Ya. Peserta yang menyelesaikan tugas dan proyek akhir akan mendapatkan sertifikat penyelesaian dari Tekoala."
            },
            {
                "q": "Bisakah pembayaran dicicil?",
                "a": "Bisa. Tersedia opsi pembayaran bertahap untuk bootcamp. Hubungi admin via WhatsApp untuk detail skema cicilan."
            },
            {
                "q": "Selain pelatihan, apakah Tekoala menerima jasa pembuatan website?",
                "a": "Ya. Kami melayani pembuatan website, aplikasi, dan jasa digital marketing untuk bisnis, UMKM, dan instansi. Lihat detailnya di halaman <a href=\"layanan.html\">Layanan Bisnis</a>."
            }
        ]
